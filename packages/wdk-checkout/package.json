{
  "name": "wdk-checkout",
  "version": "1.0.0",
  "description": "Headless WDK checkout widget \u2014 self-custodial USDt payments for ecommerce. Powers the WooCommerce 'WDK Pay' gateway and works standalone.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "default": "./dist/x402.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:widget",
    "build:types": "tsc",
    "build:widget": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode-generator": "1.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "ethers": "6.14.3",
    "typescript": "5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vitest": "^3.2.6",
    "vite": ">=6.4.3 <7",
    "ws": ">=8.21.0"
  }
}
