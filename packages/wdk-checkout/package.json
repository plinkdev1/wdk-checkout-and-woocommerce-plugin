{
  "name": "@wdk-starter/wdk-checkout",
  "version": "1.1.0",
  "description": "Headless WDK checkout widget — self-custodial USDt payments for ecommerce. Powers the WooCommerce 'WDK Pay' gateway and works standalone.",
  "type": "module",
  "license": "MIT",
  "author": "WDK Pay contributors",
  "keywords": [
    "wdk",
    "tether",
    "usdt",
    "checkout",
    "woocommerce",
    "ecommerce",
    "payments",
    "self-custodial",
    "x402",
    "eip-3009",
    "lightning",
    "stablecoin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plinkdev1/wdk-checkout-and-woocommerce-plugin.git",
    "directory": "packages/wdk-checkout"
  },
  "homepage": "https://github.com/plinkdev1/wdk-checkout-and-woocommerce-plugin/tree/main/packages/wdk-checkout#readme",
  "bugs": {
    "url": "https://github.com/plinkdev1/wdk-checkout-and-woocommerce-plugin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "default": "./dist/x402.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "default": "./dist/pricing.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions.d.ts",
      "default": "./dist/subscriptions.js"
    },
    "./swap": {
      "types": "./dist/swap.d.ts",
      "default": "./dist/swap.js"
    },
    "./lightning": {
      "types": "./dist/lightning.d.ts",
      "default": "./dist/lightning.js"
    },
    "./bitcoin": {
      "types": "./dist/bitcoin.d.ts",
      "default": "./dist/bitcoin.js"
    },
    "./sats": {
      "types": "./dist/sats.d.ts",
      "default": "./dist/sats.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:widget",
    "build:types": "tsc",
    "build:widget": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "qrcode-generator": "1.5.0"
  },
  "peerDependencies": {
    "ethers": ">=6.0.0 <7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "esbuild": "0.28.1",
    "ethers": "6.14.3",
    "typescript": "5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vitest": "^3.2.6",
    "vite": ">=6.4.3 <7",
    "ws": ">=8.21.0"
  }
}
