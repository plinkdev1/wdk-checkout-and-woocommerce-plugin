{
  "name": "wdk-checkout",
  "version": "1.0.0",
  "description": "Headless WDK checkout widget — self-custodial USDt payments for ecommerce. Powers the WooCommerce 'WDK Pay' gateway and works standalone.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "npm run build:types && npm run build:widget",
    "build:types": "tsc",
    "build:widget": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-generator": "1.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "ethers": "6.14.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
